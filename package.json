{
	"name": "playdota2win",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "tsc --noEmit && vite build",
		"preview": "npm run build && vite preview",
		"test": "node scripts/run-tests.js",
		"check": "tsc --noEmit",
		"check:watch": "tsc --noEmit --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"verify": "npm run cf-typecheck && npm run lint && npm run check && npm test && npm run build",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"cf-typecheck": "wrangler types ./src/worker-configuration.d.ts --check",
		"seed": "node scripts/seed.js",
		"seed:remote": "node scripts/seed.js --remote",
		"migrate:metadata": "node scripts/migrate-metadata.js"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.48.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.4",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.0.0",
		"eslint-plugin-react-refresh": "^0.4.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"wrangler": "^4.120.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true,
		"workerd@1.20260801.1": true
	}
}
