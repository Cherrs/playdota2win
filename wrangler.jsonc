/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "playdota2win",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-13",
	"compatibility_flags": ["nodejs_als", "nodejs_compat", "global_fetch_strictly_public"],
	"keep_vars": true,
	// Manage domains/routes in the Cloudflare dashboard; keep deployment hosts out of Git.
	"workers_dev": false,
	"minify": true,
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/*", "!/assets/*"]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05,
			"persist": true
		}
	},
	/**
	 * KV Namespaces
	 * https://developers.cloudflare.com/kv/
	 */
	"kv_namespaces": [
		{
			"binding": "APP_KV",
			"id": "f2e0a96f51484204b4a3253bd4d17772",
			"remote": true
		}
	],
	/**
	 * R2 Object Storage
	 * https://developers.cloudflare.com/r2/
	 */
	"r2_buckets": [
		{
			"binding": "UPLOADS_BUCKET",
			"bucket_name": "downloads",
			"remote": true
		}
	]
	// TURNSTILE_SITE_KEY, MUMBLE_PROXY_WS_URL, MUMBLE_PROXY_HEALTH_URL and
	// PRIMARY_DOWNLOAD_HOSTNAME are managed in the dashboard (or as Worker secrets).
	// keep_vars preserves dashboard variables. Do not add route/routes keys here.
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
